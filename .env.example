# Trusted server configuration. Never give these keys to candidate shell processes.
VERIFIER_BASE_URL=https://your-openai-compatible-provider.example/v1
VERIFIER_API_KEY=replace-me
# Only for trusted private-network development: sends API key + source in cleartext.
VERIFIER_ALLOW_INSECURE_HTTP=false
VERIFIER_MODEL=your-logprob-capable-model
# Set to the actual provider/model context window; do not guess.
VERIFIER_CONTEXT_TOKENS=131072
# Optional native JSON body fields (flattened, NOT nested under extra_body).
VERIFIER_EXTRA_BODY={}
