# Host-only credentials; never pass them to candidate tools or commit .env.
VERIFIER_BASE_URL=https://your-openai-compatible-provider.example/v1
VERIFIER_API_KEY=replace-me
VERIFIER_MODEL=your-logprob-capable-model
# For the verifier API example: set the actual model context window.
VERIFIER_CONTEXT_TOKENS=131072
# Optional provider settings for the blind scorer, not protocol overrides.
VERIFIER_EXTRA_BODY={}

# Optional separate benchmark generator; unset values fall back to VERIFIER_*.
# GENERATOR_BASE_URL=https://your-generator-provider.example/v1
# GENERATOR_API_KEY=replace-me
# GENERATOR_MODEL=your-tool-capable-model

# Optional OpenAI vanilla baseline; only this key is required.
# OPENAI_API_KEY=replace-me
# OpenAI's URL is the default. Override only for an explicit compatible endpoint.
# BASELINE_BASE_URL=https://api.openai.com/v1
# Select its available model ID using --baseline-model and API using --baseline-api.
